APP_NAME=CineQuote AI API
APP_ENV=development
FRONTEND_URL=http://localhost:5173
# Local development (default):
DATABASE_URL=sqlite:///./cinequote.db
# Production example (Render supplies postgresql://; the app selects Psycopg 3):
# DATABASE_URL=postgresql://user:password@host:5432/cinequote

# Required in production (32+ random characters). Local mode keeps legacy token hashing when empty.
SESSION_SECRET=

# Account session cookie. Set AUTH_COOKIE_SECURE=true behind production HTTPS.
AUTH_COOKIE_NAME=cinequote_session
AUTH_SESSION_DAYS=30
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Enable in production. Unsafe browser requests must originate from FRONTEND_URL.
CSRF_ORIGIN_CHECK_ENABLED=false
# Only trust X-Forwarded-For when the Vercel proxy supplies the shared secret.
TRUST_PROXY_HEADERS=false
PROXY_SHARED_SECRET=
REQUIRE_PROXY_SECRET=false

# Process-local authentication abuse limits.
LOGIN_RATE_LIMIT_IP_REQUESTS=20
LOGIN_RATE_LIMIT_ACCOUNT_REQUESTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_IP_REQUESTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# Process-local API-use limits plus a process-wide provider-call ceiling.
AI_USER_RATE_LIMIT_REQUESTS=30
AI_IP_RATE_LIMIT_REQUESTS=60
AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_GLOBAL_RATE_LIMIT_REQUESTS=300
AI_GLOBAL_RATE_LIMIT_WINDOW_SECONDS=3600

# In-memory quiz sessions expire after inactivity and are capped per process.
QUIZ_SESSION_TTL_SECONDS=3600
QUIZ_SESSION_MAX_ACTIVE=2000

# Process-local personalized-coach provider-call limit.
COACH_RATE_LIMIT_REQUESTS=5
COACH_RATE_LIMIT_WINDOW_SECONDS=60
RECOMMENDATION_RATE_LIMIT_REQUESTS=5
RECOMMENDATION_RATE_LIMIT_WINDOW_SECONDS=60

# Process-local post-answer AI explanation limit.
EXPLANATION_RATE_LIMIT_REQUESTS=10
EXPLANATION_RATE_LIMIT_WINDOW_SECONDS=60

# Process-local natural-language custom quiz planner limit.
CUSTOM_QUIZ_RATE_LIMIT_REQUESTS=10
CUSTOM_QUIZ_RATE_LIMIT_WINDOW_SECONDS=60

# AI provider: groq (default), openai, or fallback (never calls a cloud API).
AI_PROVIDER=groq

# Optional GroqCloud Free Plan configuration.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=128
GROQ_TIMEOUT_SECONDS=8

# Optional OpenAI configuration. Not required when using Groq or fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=80
OPENAI_TIMEOUT_SECONDS=8

# Process-local cloud-call protection and safe-hint cache.
HINT_RATE_LIMIT_REQUESTS=10
HINT_RATE_LIMIT_WINDOW_SECONDS=60
HINT_CACHE_ENABLED=true

