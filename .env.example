# Copy settings into the service-specific .env files when needed.
# Never commit real credentials.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
# Backend defaults to SQLite locally. Use Render's PostgreSQL connection string in production.
DATABASE_URL=sqlite:///./cinequote.db
SESSION_SECRET=
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=80
OPENAI_TIMEOUT_SECONDS=8

